{
  "name": "minimax-tts",
  "displayName": "MiniMax 文字转语音",
  "description": "使用 MiniMax 语音合成在 VS Code 中朗读选中文本、输入文本或 Agent 提供的文本。",
  "version": "0.0.9",
  "publisher": "Cameliorn",
  "license": "MIT",
  "author": "Cameliorn",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cameliorn/projectaudioplugin"
  },
  "bugs": {
    "url": "https://github.com/Cameliorn/projectaudioplugin/issues"
  },
  "homepage": "https://github.com/Cameliorn/projectaudioplugin#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "minimax",
    "tts",
    "text-to-speech",
    "audio",
    "copilot",
    "agent"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguageModelTool:minimax_tts_speak"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "minimaxTts.speakSelection",
        "title": "朗读选中文本",
        "category": "MiniMax 文字转语音",
        "icon": "$(unmute)"
      },
      {
        "command": "minimaxTts.speakInput",
        "title": "朗读输入文本",
        "category": "MiniMax 文字转语音",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "minimaxTts.setApiKey",
        "title": "设置密钥",
        "category": "MiniMax 文字转语音",
        "icon": "$(key)"
      },
      {
        "command": "minimaxTts.pause",
        "title": "暂停 / 恢复播放",
        "category": "MiniMax 文字转语音",
        "icon": "$(debug-pause)"
      },
      {
        "command": "minimaxTts.stop",
        "title": "停止播放",
        "category": "MiniMax 文字转语音",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "minimaxTts.speakSelection",
          "when": "false"
        },
        {
          "command": "minimaxTts.speakInput",
          "when": "false"
        },
        {
          "command": "minimaxTts.pause",
          "when": "false"
        },
        {
          "command": "minimaxTts.stop",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "minimaxTts.speakSelection",
          "group": "navigation@50",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "MiniMax 文字转语音",
      "properties": {
        "minimaxTts.apiHost": {
          "type": "string",
          "default": "https://api.minimax.io",
          "scope": "application",
          "description": "MiniMax API 地址。必须使用 HTTPS；默认使用全球站 https://api.minimax.io。"
        },
        "minimaxTts.model": {
          "type": "string",
          "enum": [
            "speech-2.8-hd",
            "speech-2.8-turbo",
            "speech-2.6-hd",
            "speech-2.6-turbo",
            "speech-02-hd",
            "speech-02-turbo",
            "speech-01-hd",
            "speech-01-turbo"
          ],
          "default": "speech-2.8-turbo",
          "description": "MiniMax 语音合成模型。HD 通常质量更高，Turbo 通常速度更快。"
        },
        "minimaxTts.voiceId": {
          "type": "string",
          "default": "English_expressive_narrator",
          "description": "默认音色 ID。可以填写 MiniMax 内置音色、克隆音色或账号可用的音色 ID。"
        },
        "minimaxTts.format": {
          "type": "string",
          "enum": [
            "mp3",
            "wav",
            "flac"
          ],
          "default": "mp3",
          "description": "生成音频格式。HTTP 非流式支持 mp3、wav、flac。"
        },
        "minimaxTts.sampleRate": {
          "type": "number",
          "default": 32000,
          "minimum": 8000,
          "description": "音频采样率。"
        },
        "minimaxTts.bitrate": {
          "type": "number",
          "default": 128000,
          "minimum": 16000,
          "description": "音频码率。"
        },
        "minimaxTts.channel": {
          "type": "number",
          "enum": [
            1,
            2
          ],
          "default": 1,
          "description": "音频声道数。1 为单声道，2 为双声道。"
        },
        "minimaxTts.speed": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "语速。"
        },
        "minimaxTts.vol": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "音量。"
        },
        "minimaxTts.pitch": {
          "type": "number",
          "default": 0,
          "minimum": -12,
          "maximum": 12,
          "description": "音高。"
        },
        "minimaxTts.languageBoost": {
          "type": "string",
          "enum": [
            "auto",
            "Chinese",
            "Chinese,Yue",
            "English",
            "Arabic",
            "Russian",
            "Spanish",
            "French",
            "Portuguese",
            "German",
            "Turkish",
            "Dutch",
            "Ukrainian",
            "Vietnamese",
            "Indonesian",
            "Japanese",
            "Italian",
            "Korean",
            "Thai",
            "Polish",
            "Romanian",
            "Greek",
            "Czech",
            "Finnish",
            "Hindi",
            "Bulgarian",
            "Danish",
            "Hebrew",
            "Malay",
            "Persian",
            "Slovak",
            "Swedish",
            "Croatian",
            "Filipino",
            "Hungarian",
            "Norwegian",
            "Slovenian",
            "Catalan",
            "Nynorsk",
            "Tamil",
            "Afrikaans"
          ],
          "default": "auto",
          "description": "语言增强。未知语言建议使用 auto。"
        },
        "minimaxTts.pronunciationTone": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "发音词典 tone 数组。例如 Omg/Oh my god。为空时不发送 pronunciation_dict。"
        },
        "minimaxTts.voiceModifyEnabled": {
          "type": "boolean",
          "default": false,
          "description": "是否启用 voice_modify 变声/音效参数。"
        },
        "minimaxTts.voiceModifyPitch": {
          "type": "number",
          "default": 0,
          "minimum": -12,
          "maximum": 12,
          "description": "voice_modify.pitch，变声音高。仅在启用 voice_modify 时发送。"
        },
        "minimaxTts.voiceModifyIntensity": {
          "type": "number",
          "default": 0,
          "description": "voice_modify.intensity，变声强度。仅在启用 voice_modify 时发送。"
        },
        "minimaxTts.voiceModifyTimbre": {
          "type": "number",
          "default": 0,
          "description": "voice_modify.timbre，音色变化。仅在启用 voice_modify 时发送。"
        },
        "minimaxTts.voiceModifySoundEffects": {
          "type": "string",
          "default": "",
          "description": "voice_modify.sound_effects，音效名称。例如 spacious_echo。留空则不发送 sound_effects。"
        },
        "minimaxTts.subtitleEnable": {
          "type": "boolean",
          "default": false,
          "description": "是否请求字幕时间戳信息。当前插件主要用于播放音频，不显示字幕，但会把该参数发送给 MiniMax。"
        },
        "minimaxTts.subtitleType": {
          "type": "string",
          "enum": [
            "sentence",
            "word"
          ],
          "default": "sentence",
          "description": "字幕粒度。HTTP 非流式建议使用 sentence 或 word。"
        },
        "minimaxTts.extraRequestJson": {
          "type": "object",
          "default": {},
          "description": "高级 MiniMax T2A 请求参数。可放入官方新增字段或未单独暴露的字段，例如 timbre_weights。插件会保留播放所需的 model、text、stream、output_format、voice_setting、audio_setting 等核心字段。"
        },
        "minimaxTts.cacheEnabled": {
          "type": "boolean",
          "default": true,
          "description": "是否复用相同文本和相同参数生成过的音频缓存。"
        },
        "minimaxTts.cacheMaxSizeMb": {
          "type": "number",
          "default": 512,
          "minimum": 0,
          "description": "音频缓存最大体积（MB）。设为 0 可关闭大小清理。"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "minimax_tts_speak",
        "tags": [
          "minimax",
          "tts",
          "audio"
        ],
        "toolReferenceName": "speakText",
        "displayName": "朗读文本",
        "modelDescription": "使用 MiniMax 语音合成将提供的文本转换为语音并在 VS Code 中播放。仅当用户明确要求朗读、播放、读出、旁白或文字转语音时使用。本工具会消耗 MiniMax 额度或账户余额，并会在用户编辑器中播放声音；不要用于普通解释或摘要。",
        "userDescription": "使用 MiniMax 语音合成朗读文本。",
        "canBeReferencedInPrompt": true,
        "icon": "$(unmute)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "要转换为语音并播放的文本。"
            },
            "voice_id": {
              "type": "string",
              "description": "可选的 MiniMax 音色 ID。"
            },
            "model": {
              "type": "string",
              "description": "可选的 MiniMax 语音模型。"
            }
          },
          "required": [
            "text"
          ]
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test --ext ts",
    "pretest": "npm run lint",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "vsce package --allow-missing-repository",
    "dev:open": "npm run compile && node ./scripts/openExtensionHost.js",
    "vscode:prepublish": "npm run lint && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vscode/vsce": "^3.6.3",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.1",
    "typescript": "^5.7.3"
  }
}