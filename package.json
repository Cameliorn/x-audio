{
  "name": "x-audio",
  "displayName": "x-audio 朗读助手",
  "description": "%xaudio.description%",
  "version": "1.0.4",
  "publisher": "Cameliorn",
  "icon": "icon.png",
  "license": "MIT",
  "author": "Cameliorn",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cameliorn/x-audio"
  },
  "bugs": {
    "url": "https://github.com/Cameliorn/x-audio/issues"
  },
  "homepage": "https://github.com/Cameliorn/x-audio#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tts",
    "text-to-speech",
    "audio",
    "read-aloud",
    "copilot",
    "agent"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguageModelTool:xaudio_speak",
    "onLanguageModelTool:xaudio_scene"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "xaudio.speakSelection",
        "title": "%xaudio.commands.speakSelection.title%",
        "category": "%xaudio.commands.category%",
        "icon": "$(unmute)"
      },
      {
        "command": "xaudio.speakDocumentWithRoles",
        "title": "%xaudio.commands.speakDocumentWithRoles.title%",
        "category": "%xaudio.commands.category%",
        "icon": "$(book)"
      },
      {
        "command": "xaudio.speakScenePrompt",
        "title": "%xaudio.commands.speakScenePrompt.title%",
        "category": "%xaudio.commands.category%",
        "icon": "$(megaphone)"
      },
      {
        "command": "xaudio.setApiKey",
        "title": "%xaudio.commands.setApiKey.title%",
        "category": "%xaudio.commands.category%",
        "icon": "$(key)"
      },
      {
        "command": "xaudio.pause",
        "title": "%xaudio.commands.pause.title%",
        "category": "%xaudio.commands.category%",
        "icon": "$(debug-pause)"
      },
      {
        "command": "xaudio.stop",
        "title": "%xaudio.commands.stop.title%",
        "category": "%xaudio.commands.category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "xaudio.configureRoleAnalysis",
        "title": "%xaudio.commands.configureRoleAnalysis.title%",
        "category": "%xaudio.commands.category%",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "xaudio.speakSelection",
          "when": "false"
        },
        {
          "command": "xaudio.pause",
          "when": "xaudio.playing"
        },
        {
          "command": "xaudio.stop",
          "when": "xaudio.playing"
        }
      ],
      "editor/context": [
        {
          "command": "xaudio.speakSelection",
          "group": "1_xaudio@1",
          "when": "editorHasSelection"
        },
        {
          "command": "xaudio.speakDocumentWithRoles",
          "group": "1_xaudio@2"
        },
        {
          "command": "xaudio.speakScenePrompt",
          "group": "1_xaudio@3",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "%xaudio.configuration.title%",
      "properties": {
        "xaudio.provider": {
          "order": 1,
          "type": "string",
          "default": "minimax",
          "enum": [
            "minimax"
          ],
          "enumDescriptions": [
            "%xaudio.configuration.properties.provider.enum.minimax%"
          ],
          "scope": "application",
          "description": "%xaudio.configuration.properties.provider.description%"
        },
        "xaudio.doubao.apiHost": {
          "order": 10,
          "type": "string",
          "default": "https://openspeech.bytedance.com",
          "scope": "application",
          "description": "%xaudio.configuration.properties.doubao.apiHost.description%"
        },
        "xaudio.doubao.model": {
          "order": 11,
          "type": "string",
          "enum": [
            "seed-audio-1.0"
          ],
          "default": "seed-audio-1.0",
          "description": "%xaudio.configuration.properties.doubao.model.description%"
        },
        "xaudio.doubao.format": {
          "order": 12,
          "type": "string",
          "enum": [
            "mp3",
            "wav"
          ],
          "default": "mp3",
          "description": "%xaudio.configuration.properties.doubao.format.description%"
        },
        "xaudio.doubao.sampleRate": {
          "order": 13,
          "type": "number",
          "default": 24000,
          "minimum": 8000,
          "description": "%xaudio.configuration.properties.doubao.sampleRate.description%"
        },
        "xaudio.doubao.speechRate": {
          "order": 14,
          "type": "number",
          "default": 0,
          "minimum": -50,
          "maximum": 100,
          "description": "%xaudio.configuration.properties.doubao.speechRate.description%"
        },
        "xaudio.doubao.loudnessRate": {
          "order": 15,
          "type": "number",
          "default": 0,
          "minimum": -100,
          "maximum": 100,
          "description": "%xaudio.configuration.properties.doubao.loudnessRate.description%"
        },
        "xaudio.doubao.pitchRate": {
          "order": 16,
          "type": "number",
          "default": 0,
          "minimum": -12,
          "maximum": 12,
          "description": "%xaudio.configuration.properties.doubao.pitchRate.description%"
        },
        "xaudio.doubao.subtitleEnable": {
          "order": 17,
          "type": "boolean",
          "default": false,
          "description": "%xaudio.configuration.properties.doubao.subtitleEnable.description%"
        },
        "xaudio.doubao.extraRequestJson": {
          "order": 18,
          "type": "object",
          "default": {},
          "description": "%xaudio.configuration.properties.doubao.extraRequestJson.description%"
        },
        "xaudio.minimax.apiHost": {
          "order": 10,
          "type": "string",
          "default": "https://api.minimax.io",
          "scope": "application",
          "description": "%xaudio.configuration.properties.minimax.apiHost.description%"
        },
        "xaudio.minimax.model": {
          "order": 11,
          "type": "string",
          "enum": [
            "speech-2.8-hd",
            "speech-2.8-turbo",
            "speech-2.6-hd",
            "speech-2.6-turbo",
            "speech-02-hd",
            "speech-02-turbo",
            "speech-01-hd",
            "speech-01-turbo"
          ],
          "default": "speech-2.8-turbo",
          "description": "%xaudio.configuration.properties.minimax.model.description%"
        },
        "xaudio.minimax.format": {
          "order": 12,
          "type": "string",
          "enum": [
            "mp3",
            "wav",
            "flac"
          ],
          "default": "mp3",
          "description": "%xaudio.configuration.properties.minimax.format.description%"
        },
        "xaudio.minimax.sampleRate": {
          "order": 13,
          "type": "number",
          "default": 32000,
          "minimum": 8000,
          "description": "%xaudio.configuration.properties.minimax.sampleRate.description%"
        },
        "xaudio.minimax.bitrate": {
          "order": 14,
          "type": "number",
          "default": 128000,
          "minimum": 16000,
          "description": "%xaudio.configuration.properties.minimax.bitrate.description%"
        },
        "xaudio.minimax.channel": {
          "order": 15,
          "type": "number",
          "enum": [
            1,
            2
          ],
          "default": 1,
          "description": "%xaudio.configuration.properties.minimax.channel.description%"
        },
        "xaudio.minimax.languageBoost": {
          "order": 16,
          "type": "string",
          "enum": [
            "auto",
            "Chinese",
            "Chinese,Yue",
            "English",
            "Arabic",
            "Russian",
            "Spanish",
            "French",
            "Portuguese",
            "German",
            "Turkish",
            "Dutch",
            "Ukrainian",
            "Vietnamese",
            "Indonesian",
            "Japanese",
            "Italian",
            "Korean",
            "Thai",
            "Polish",
            "Romanian",
            "Greek",
            "Czech",
            "Finnish",
            "Hindi",
            "Bulgarian",
            "Danish",
            "Hebrew",
            "Malay",
            "Persian",
            "Slovak",
            "Swedish",
            "Croatian",
            "Filipino",
            "Hungarian",
            "Norwegian",
            "Slovenian",
            "Catalan",
            "Nynorsk",
            "Tamil",
            "Afrikaans"
          ],
          "default": "auto",
          "description": "%xaudio.configuration.properties.minimax.languageBoost.description%"
        },
        "xaudio.minimax.pronunciationTone": {
          "order": 17,
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%xaudio.configuration.properties.minimax.pronunciationTone.description%"
        },
        "xaudio.minimax.extraRequestJson": {
          "order": 18,
          "type": "object",
          "default": {},
          "description": "%xaudio.configuration.properties.minimax.extraRequestJson.description%"
        },
        "xaudio.minimax.voiceId": {
          "order": 20,
          "type": "string",
          "default": "English_expressive_narrator",
          "description": "%xaudio.configuration.properties.minimax.voiceId.description%"
        },
        "xaudio.minimax.speed": {
          "order": 21,
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "%xaudio.configuration.properties.minimax.speed.description%"
        },
        "xaudio.minimax.vol": {
          "order": 22,
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "%xaudio.configuration.properties.minimax.vol.description%"
        },
        "xaudio.minimax.pitch": {
          "order": 23,
          "type": "number",
          "default": 0,
          "minimum": -12,
          "maximum": 12,
          "description": "%xaudio.configuration.properties.minimax.pitch.description%"
        },
        "xaudio.minimax.voiceModifyEnabled": {
          "order": 30,
          "type": "boolean",
          "default": false,
          "description": "%xaudio.configuration.properties.minimax.voiceModifyEnabled.description%"
        },
        "xaudio.minimax.voiceModifyPitch": {
          "order": 31,
          "type": "number",
          "default": 0,
          "minimum": -12,
          "maximum": 12,
          "description": "%xaudio.configuration.properties.minimax.voiceModifyPitch.description%"
        },
        "xaudio.minimax.voiceModifyIntensity": {
          "order": 32,
          "type": "number",
          "default": 0,
          "description": "%xaudio.configuration.properties.minimax.voiceModifyIntensity.description%"
        },
        "xaudio.minimax.voiceModifyTimbre": {
          "order": 33,
          "type": "number",
          "default": 0,
          "description": "%xaudio.configuration.properties.minimax.voiceModifyTimbre.description%"
        },
        "xaudio.minimax.voiceModifySoundEffects": {
          "order": 34,
          "type": "string",
          "default": "",
          "description": "%xaudio.configuration.properties.minimax.voiceModifySoundEffects.description%"
        },
        "xaudio.minimax.subtitleEnable": {
          "order": 40,
          "type": "boolean",
          "default": false,
          "description": "%xaudio.configuration.properties.minimax.subtitleEnable.description%"
        },
        "xaudio.minimax.subtitleType": {
          "order": 41,
          "type": "string",
          "enum": [
            "sentence",
            "word"
          ],
          "default": "sentence",
          "description": "%xaudio.configuration.properties.minimax.subtitleType.description%"
        },
        "xaudio.minimax.roleVoices": {
          "order": 70,
          "type": "object",
          "default": {
            "narrator": "audiobook_female_1",
            "male": "female-yujie",
            "female": "female-tianmei",
            "girl": "female-shaonv",
            "boy": "female-shaonv",
            "child": "female-shaonv",
            "elderly": "audiobook_female_2"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "%xaudio.configuration.properties.minimax.roleVoices.description%"
        },
        "xaudio.cacheEnabled": {
          "order": 50,
          "type": "boolean",
          "default": true,
          "description": "%xaudio.configuration.properties.cacheEnabled.description%"
        },
        "xaudio.cacheMaxSizeMb": {
          "order": 51,
          "type": "number",
          "default": 512,
          "minimum": 0,
          "description": "%xaudio.configuration.properties.cacheMaxSizeMb.description%"
        },
        "xaudio.maxTextLength": {
          "order": 52,
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "description": "%xaudio.configuration.properties.maxTextLength.description%"
        },
        "xaudio.requestTimeoutMs": {
          "order": 53,
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "%xaudio.configuration.properties.requestTimeoutMs.description%"
        },
        "xaudio.maxConcurrentRequests": {
          "order": 54,
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "%xaudio.configuration.properties.maxConcurrentRequests.description%"
        },
        "xaudio.browserPath": {
          "order": 60,
          "type": "string",
          "default": "",
          "description": "%xaudio.configuration.properties.browserPath.description%"
        },
        "xaudio.roleAnalysis.provider": {
          "order": 71,
          "type": "string",
          "default": "openai",
          "enum": [
            "copilot",
            "openai"
          ],
          "enumDescriptions": [
            "%xaudio.configuration.properties.roleAnalysisProvider.copilot%",
            "%xaudio.configuration.properties.roleAnalysisProvider.openai%"
          ],
          "scope": "application",
          "description": "%xaudio.configuration.properties.roleAnalysisProvider.description%"
        },
        "xaudio.roleAnalysis.copilotModelId": {
          "order": 72,
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%xaudio.configuration.properties.roleAnalysisCopilotModelId.description%"
        },
        "xaudio.roleAnalysis.openaiEndpoint": {
          "order": 73,
          "type": "string",
          "default": "https://api.deepseek.com",
          "scope": "application",
          "description": "%xaudio.configuration.properties.roleAnalysisOpenaiEndpoint.description%"
        },
        "xaudio.roleAnalysis.openaiModel": {
          "order": 74,
          "type": "string",
          "default": "deepseek-chat",
          "scope": "application",
          "description": "%xaudio.configuration.properties.roleAnalysisOpenaiModel.description%"
        },
        "xaudio.roleAnalysis.customPrompt": {
          "order": 75,
          "type": "string",
          "default": "",
          "description": "%xaudio.configuration.properties.roleAnalysisCustomPrompt.description%"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "xaudio_speak",
        "tags": [
          "tts",
          "audio",
          "read-aloud"
        ],
        "toolReferenceName": "speakText",
        "displayName": "%xaudio.languageModelTools.speakText.displayName%",
        "modelDescription": "%xaudio.languageModelTools.speakText.modelDescription%",
        "userDescription": "%xaudio.languageModelTools.speakText.userDescription%",
        "canBeReferencedInPrompt": true,
        "icon": "$(unmute)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "%xaudio.languageModelTools.speakText.inputSchema.text.description%"
            },
            "voice_id": {
              "type": "string",
              "description": "%xaudio.languageModelTools.speakText.inputSchema.voice_id.description%"
            },
            "model": {
              "type": "string",
              "description": "%xaudio.languageModelTools.speakText.inputSchema.model.description%"
            }
          },
          "required": [
            "text"
          ]
        }
      },
      {
        "name": "xaudio_scene",
        "tags": [
          "tts",
          "audio",
          "scene"
        ],
        "toolReferenceName": "audioScene",
        "displayName": "%xaudio.languageModelTools.scene.displayName%",
        "modelDescription": "%xaudio.languageModelTools.scene.modelDescription%",
        "userDescription": "%xaudio.languageModelTools.scene.userDescription%",
        "canBeReferencedInPrompt": true,
        "icon": "$(megaphone)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "description": "%xaudio.languageModelTools.scene.inputSchema.prompt.description%"
            }
          },
          "required": [
            "prompt"
          ]
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test --ext ts",
    "pretest": "npm run lint",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "vsce package --allow-missing-repository",
    "dev:open": "npm run compile && node ./scripts/openExtensionHost.js",
    "vscode:prepublish": "npm run lint && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vscode/vsce": "^3.6.3",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.1",
    "typescript": "^5.7.3"
  }
}