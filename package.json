{
  "name": "minimax-tts",
  "displayName": "MiniMax TTS",
  "description": "%minimaxTts.description%",
  "version": "0.1.1",
  "publisher": "Cameliorn",
  "icon": "icon.png",
  "license": "MIT",
  "author": "Cameliorn",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cameliorn/projectaudioplugin"
  },
  "bugs": {
    "url": "https://github.com/Cameliorn/projectaudioplugin/issues"
  },
  "homepage": "https://github.com/Cameliorn/projectaudioplugin#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "minimax",
    "tts",
    "text-to-speech",
    "audio",
    "copilot",
    "agent"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguageModelTool:minimax_tts_speak"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "minimaxTts.speakSelection",
        "title": "%minimaxTts.commands.speakSelection.title%",
        "category": "%minimaxTts.commands.category%",
        "icon": "$(unmute)"
      },
      {
        "command": "minimaxTts.speakInput",
        "title": "%minimaxTts.commands.speakInput.title%",
        "category": "%minimaxTts.commands.category%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "minimaxTts.speakDocumentWithRoles",
        "title": "%minimaxTts.commands.speakDocumentWithRoles.title%",
        "category": "%minimaxTts.commands.category%",
        "icon": "$(book)"
      },
      {
        "command": "minimaxTts.setApiKey",
        "title": "%minimaxTts.commands.setApiKey.title%",
        "category": "%minimaxTts.commands.category%",
        "icon": "$(key)"
      },
      {
        "command": "minimaxTts.pause",
        "title": "%minimaxTts.commands.pause.title%",
        "category": "%minimaxTts.commands.category%",
        "icon": "$(debug-pause)"
      },
      {
        "command": "minimaxTts.stop",
        "title": "%minimaxTts.commands.stop.title%",
        "category": "%minimaxTts.commands.category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "minimaxTts.configureRoleAnalysis",
        "title": "%minimaxTts.commands.configureRoleAnalysis.title%",
        "category": "%minimaxTts.commands.category%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "minimaxTts.setSoundEffectsDir",
        "title": "%minimaxTts.commands.setSoundEffectsDir.title%",
        "category": "%minimaxTts.commands.category%",
        "icon": "$(folder-library)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "minimaxTts.speakSelection",
          "when": "false"
        },
        {
          "command": "minimaxTts.speakInput",
          "when": "false"
        },
        {
          "command": "minimaxTts.pause",
          "when": "false"
        },
        {
          "command": "minimaxTts.stop",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "minimaxTts.speakSelection",
          "group": "1_minimaxTts@1",
          "when": "editorHasSelection"
        },
        {
          "command": "minimaxTts.speakDocumentWithRoles",
          "group": "1_minimaxTts@2"
        }
      ]
    },
    "configuration": {
      "title": "%minimaxTts.configuration.title%",
      "properties": {
        "minimaxTts.apiHost": {
          "order": 10,
          "type": "string",
          "default": "https://api.minimax.io",
          "scope": "application",
          "description": "%minimaxTts.configuration.properties.apiHost.description%"
        },
        "minimaxTts.model": {
          "order": 11,
          "type": "string",
          "enum": [
            "speech-2.8-hd",
            "speech-2.8-turbo",
            "speech-2.6-hd",
            "speech-2.6-turbo",
            "speech-02-hd",
            "speech-02-turbo",
            "speech-01-hd",
            "speech-01-turbo"
          ],
          "default": "speech-2.8-turbo",
          "description": "%minimaxTts.configuration.properties.model.description%"
        },
        "minimaxTts.format": {
          "order": 12,
          "type": "string",
          "enum": [
            "mp3",
            "wav",
            "flac"
          ],
          "default": "mp3",
          "description": "%minimaxTts.configuration.properties.format.description%"
        },
        "minimaxTts.sampleRate": {
          "order": 13,
          "type": "number",
          "default": 32000,
          "minimum": 8000,
          "description": "%minimaxTts.configuration.properties.sampleRate.description%"
        },
        "minimaxTts.bitrate": {
          "order": 14,
          "type": "number",
          "default": 128000,
          "minimum": 16000,
          "description": "%minimaxTts.configuration.properties.bitrate.description%"
        },
        "minimaxTts.channel": {
          "order": 15,
          "type": "number",
          "enum": [
            1,
            2
          ],
          "default": 1,
          "description": "%minimaxTts.configuration.properties.channel.description%"
        },
        "minimaxTts.languageBoost": {
          "order": 16,
          "type": "string",
          "enum": [
            "auto",
            "Chinese",
            "Chinese,Yue",
            "English",
            "Arabic",
            "Russian",
            "Spanish",
            "French",
            "Portuguese",
            "German",
            "Turkish",
            "Dutch",
            "Ukrainian",
            "Vietnamese",
            "Indonesian",
            "Japanese",
            "Italian",
            "Korean",
            "Thai",
            "Polish",
            "Romanian",
            "Greek",
            "Czech",
            "Finnish",
            "Hindi",
            "Bulgarian",
            "Danish",
            "Hebrew",
            "Malay",
            "Persian",
            "Slovak",
            "Swedish",
            "Croatian",
            "Filipino",
            "Hungarian",
            "Norwegian",
            "Slovenian",
            "Catalan",
            "Nynorsk",
            "Tamil",
            "Afrikaans"
          ],
          "default": "auto",
          "description": "%minimaxTts.configuration.properties.languageBoost.description%"
        },
        "minimaxTts.pronunciationTone": {
          "order": 17,
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%minimaxTts.configuration.properties.pronunciationTone.description%"
        },
        "minimaxTts.extraRequestJson": {
          "order": 18,
          "type": "object",
          "default": {},
          "description": "%minimaxTts.configuration.properties.extraRequestJson.description%"
        },
        "minimaxTts.voiceId": {
          "order": 20,
          "type": "string",
          "default": "English_expressive_narrator",
          "description": "%minimaxTts.configuration.properties.voiceId.description%"
        },
        "minimaxTts.speed": {
          "order": 21,
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "%minimaxTts.configuration.properties.speed.description%"
        },
        "minimaxTts.vol": {
          "order": 22,
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "%minimaxTts.configuration.properties.vol.description%"
        },
        "minimaxTts.pitch": {
          "order": 23,
          "type": "number",
          "default": 0,
          "minimum": -12,
          "maximum": 12,
          "description": "%minimaxTts.configuration.properties.pitch.description%"
        },
        "minimaxTts.voiceModifyEnabled": {
          "order": 30,
          "type": "boolean",
          "default": false,
          "description": "%minimaxTts.configuration.properties.voiceModifyEnabled.description%"
        },
        "minimaxTts.voiceModifyPitch": {
          "order": 31,
          "type": "number",
          "default": 0,
          "minimum": -12,
          "maximum": 12,
          "description": "%minimaxTts.configuration.properties.voiceModifyPitch.description%"
        },
        "minimaxTts.voiceModifyIntensity": {
          "order": 32,
          "type": "number",
          "default": 0,
          "description": "%minimaxTts.configuration.properties.voiceModifyIntensity.description%"
        },
        "minimaxTts.voiceModifyTimbre": {
          "order": 33,
          "type": "number",
          "default": 0,
          "description": "%minimaxTts.configuration.properties.voiceModifyTimbre.description%"
        },
        "minimaxTts.voiceModifySoundEffects": {
          "order": 34,
          "type": "string",
          "default": "",
          "description": "%minimaxTts.configuration.properties.voiceModifySoundEffects.description%"
        },
        "minimaxTts.subtitleEnable": {
          "order": 40,
          "type": "boolean",
          "default": false,
          "description": "%minimaxTts.configuration.properties.subtitleEnable.description%"
        },
        "minimaxTts.subtitleType": {
          "order": 41,
          "type": "string",
          "enum": [
            "sentence",
            "word"
          ],
          "default": "sentence",
          "description": "%minimaxTts.configuration.properties.subtitleType.description%"
        },
        "minimaxTts.cacheEnabled": {
          "order": 50,
          "type": "boolean",
          "default": true,
          "description": "%minimaxTts.configuration.properties.cacheEnabled.description%"
        },
        "minimaxTts.cacheMaxSizeMb": {
          "order": 51,
          "type": "number",
          "default": 512,
          "minimum": 0,
          "description": "%minimaxTts.configuration.properties.cacheMaxSizeMb.description%"
        },
        "minimaxTts.maxTextLength": {
          "order": 52,
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "description": "%minimaxTts.configuration.properties.maxTextLength.description%"
        },
        "minimaxTts.requestTimeoutMs": {
          "order": 53,
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "%minimaxTts.configuration.properties.requestTimeoutMs.description%"
        },
        "minimaxTts.browserPath": {
          "order": 60,
          "type": "string",
          "default": "",
          "description": "%minimaxTts.configuration.properties.browserPath.description%"
        },
        "minimaxTts.roleVoices": {
          "order": 70,
          "type": "object",
          "default": {
            "narrator": "audiobook_female_1",
            "male": "female-yujie",
            "female": "female-tianmei",
            "girl": "female-shaonv",
            "boy": "female-shaonv",
            "child": "female-shaonv",
            "elderly": "audiobook_female_2"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "%minimaxTts.configuration.properties.roleVoices.description%"
        },
        "minimaxTts.roleAnalysis.openaiEndpoint": {
          "order": 71,
          "type": "string",
          "default": "https://api.deepseek.com",
          "scope": "application",
          "description": "%minimaxTts.configuration.properties.roleAnalysisOpenaiEndpoint.description%"
        },
        "minimaxTts.roleAnalysis.openaiModel": {
          "order": 72,
          "type": "string",
          "default": "deepseek-chat",
          "scope": "application",
          "description": "%minimaxTts.configuration.properties.roleAnalysisOpenaiModel.description%"
        },
        "minimaxTts.roleAnalysis.customPrompt": {
          "order": 73,
          "type": "string",
          "default": "",
          "description": "%minimaxTts.configuration.properties.roleAnalysisCustomPrompt.description%"
        },
        "minimaxTts.soundEffectsDir": {
          "order": 74,
          "type": "string",
          "default": "",
          "description": "%minimaxTts.configuration.properties.soundEffectsDir.description%"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "minimax_tts_speak",
        "tags": [
          "minimax",
          "tts",
          "audio"
        ],
        "toolReferenceName": "speakText",
        "displayName": "%minimaxTts.languageModelTools.speakText.displayName%",
        "modelDescription": "%minimaxTts.languageModelTools.speakText.modelDescription%",
        "userDescription": "%minimaxTts.languageModelTools.speakText.userDescription%",
        "canBeReferencedInPrompt": true,
        "icon": "$(unmute)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "%minimaxTts.languageModelTools.speakText.inputSchema.text.description%"
            },
            "voice_id": {
              "type": "string",
              "description": "%minimaxTts.languageModelTools.speakText.inputSchema.voice_id.description%"
            },
            "model": {
              "type": "string",
              "description": "%minimaxTts.languageModelTools.speakText.inputSchema.model.description%"
            }
          },
          "required": [
            "text"
          ]
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test --ext ts",
    "pretest": "npm run lint",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "vsce package --allow-missing-repository",
    "dev:open": "npm run compile && node ./scripts/openExtensionHost.js",
    "vscode:prepublish": "npm run lint && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vscode/vsce": "^3.6.3",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.1",
    "typescript": "^5.7.3"
  }
}